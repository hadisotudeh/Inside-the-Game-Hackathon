# Copy to .env for local overrides. No credentials are needed to start the API.
GAME_APP_NAME=Inside the Game

# template makes no model calls; off disables explanations entirely.
# Set foundry only when ready to make potentially billable Azure calls.
GAME_EXPLANATION_PROVIDER=template
# Azure resource root, not the project endpoint or /models endpoint.
GAME_FOUNDRY_ENDPOINT=
GAME_FOUNDRY_DEPLOYMENT=
GAME_FOUNDRY_API_KEY=
GAME_EXPLANATION_TIMEOUT_SECONDS=10
GAME_EXPLANATION_MAX_CALLS=12
# Wall-clock seconds between requests, per replay connection.
GAME_EXPLANATION_INTERVAL_SECONDS=30

# Ask the match: free-tier Gemini key, used only by the backend.
GAME_GEMINI_API_KEY=
GAME_GEMINI_MODEL=gemini-3.8-flash
