[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = "*"
httpx = "*"
pydantic-settings = "*"
agent-framework-core = "<2,>=1"

[dev-packages]
pytest = "*"
ruff = "*"

[requires]
python_version = "3.14"

[scripts]
dev = "python -m app.dev"
demo = "python -m tools.demo.server"
start = "uvicorn app.main:app --host 0.0.0.0 --port 8000"
test = "python -m pytest"
lint = "ruff check ."
format = "ruff format ."
